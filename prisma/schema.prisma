// Esquema de la base de dades (Prisma) del projecte "Physics Stars".
// La base de dades real serà un Neon Postgres connectat a través de Vercel;
// aquest fitxer defineix l'estructura perquè, un cop es connecti la variable
// d'entorn DATABASE_URL, tot funcioni sense haver de tocar el codi.

generator client {
  provider = "prisma-client-js"
}

// A partir de Prisma 7, les URLs de connexió ja no es defineixen aquí:
// la connexió per a migracions es configura a `prisma.config.ts`, i la
// connexió que fa servir l'aplicació en temps d'execució es passa
// explícitament com a "driver adapter" en crear el PrismaClient
// (vegeu src/lib/db/client.ts).
datasource db {
  provider = "postgresql"
}

// Rol de l'usuari dins l'aplicació. Permet distingir alumnat, professorat
// i administració sense necessitat de taules addicionals de moment.
enum Role {
  STUDENT
  TEACHER
  ADMIN
}

// Compte d'usuari. La contrasenya mai es guarda en text pla: només
// s'emmagatzema el resultat de l'algorisme Argon2id (vegeu server/security/password.ts).
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(STUDENT)
  // Compte desactivat: no pot iniciar sessió, però es conserva a la base
  // de dades (mai s'esborren usuaris des de l'aplicació).
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Només té sentit per a alumnat (STUDENT): l'aula on està assignat.
  // Si s'esborra l'aula, l'alumne queda "sense aula" (SetNull) en lloc
  // d'esborrar-se.
  classroomId String?
  classroom   Classroom? @relation("ClassroomStudents", fields: [classroomId], references: [id], onDelete: SetNull)

  // Només té sentit per a professorat (TEACHER): les aules que imparteix.
  taughtClassrooms Classroom[] @relation("ClassroomTeacher")

  sessions Session[]

  @@index([classroomId])
  @@index([role])
  @@map("users")
}

// Aula ("classe") gestionada per un professor, amb l'alumnat assignat.
model Classroom {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   User   @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  students User[] @relation("ClassroomStudents")

  // Contingut que el professor ha amagat a l'alumnat d'aquesta aula.
  hiddenWorlds ClassroomHiddenWorld[]
  hiddenLevels ClassroomHiddenLevel[]

  @@index([teacherId])
  @@map("classrooms")
}

// Dificultat d'un nivell (text lliure evitat a propòsit: es prefereix un
// enum tipat perquè la interfície sempre mostri un valor vàlid i conegut).
enum Difficulty {
  FACIL
  MITJA
  DIFICIL
}

// Un "món" del joc: un bloc temàtic de física (p. ex. Cinemàtica) amb els
// seus nivells. `isAvailable` distingeix el contingut ja publicat del que
// encara està "Properament" — no hi ha (encara) seguiment de progrés per
// alumne: això depèn del joc real (Unity), que encara no està integrat.
model World {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  tagline          String
  shortDescription String
  description      String
  // Llista de missions/objectius mostrats al panell de detall.
  objectives       String[]
  order            Int     @default(0)
  isAvailable      Boolean @default(true)

  levels   Level[]
  hiddenIn ClassroomHiddenWorld[]

  @@map("worlds")
}

// Un nivell dins d'un món.
model Level {
  id          String     @id @default(cuid())
  title       String
  levelNumber Int
  description String
  difficulty  Difficulty
  order       Int        @default(0)
  isAvailable Boolean    @default(true)

  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  hiddenIn ClassroomHiddenLevel[]

  @@index([worldId])
  @@map("levels")
}

// Visibilitat per aula: si hi ha una fila, el professor ha AMAGAT aquell
// món/nivell a l'alumnat d'aquella aula (per defecte tot és visible).
// L'admin controla la disponibilitat global amb `isAvailable`; el
// professor només pot amagar/mostrar contingut per a les seves aules.
model ClassroomHiddenWorld {
  classroomId String
  worldId     String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  world       World     @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([classroomId, worldId])
  @@map("classroom_hidden_worlds")
}

model ClassroomHiddenLevel {
  classroomId String
  levelId     String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  level       Level     @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([classroomId, levelId])
  @@map("classroom_hidden_levels")
}

// Sessió activa d'un usuari. `id` és el hash SHA-256 del token de sessió
// (el token en cru només viatja dins la cookie httpOnly del navegador),
// de manera que si algú accedís a la base de dades no podria suplantar
// cap sessió a partir d'aquesta taula.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
